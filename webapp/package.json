{
  "name": "academie-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "Browse class notes and execute experiments from the repository",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
